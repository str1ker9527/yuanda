              },
              {
                "id": "task-row-2",
                "values": {
                  "title": "画出页面",
                  "detail": "把内容放到合适的位置",
                  "priority": 2
                }
              },
              {
                "id": "task-row-3",
                "values": {
                  "title": "加入交互",
                  "detail": "让按钮带来真实反馈",
                  "priority": 3
                }
              },
              {
                "id": "task-row-4",
                "values": {
                  "title": "整理组件",
                  "detail": "把重复内容做成母版",
                  "priority": 2
                }
              },
              {
                "id": "task-row-5",
                "values": {
                  "title": "导入数据",
                  "detail": "先检查列，再一次写入",
                  "priority": 3
                }
              },
              {
                "id": "task-row-6",
                "values": {
                  "title": "检查导出",
                  "detail": "用浏览器亲手走一遍",
                  "priority": 1
                }
              },
              {
                "id": "task-row-7",
                "values": {
                  "title": "交给 Agent",
                  "detail": "通过指令批量编辑",
                  "priority": 2
                }
              },
              {
                "id": "task-row-8",
                "values": {
                  "title": "保存项目",
                  "detail": "保留可继续修改的设计",
                  "priority": 1
                }
              }
